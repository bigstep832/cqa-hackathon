{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CQA results 1.0 — team formalization",
  "description": "Team-authored structural schema derived from the Results Appendix. Dataset-specific counts, exact source IDs, evidence bounds, scoring, provenance and privacy require the offline semantic validator described in docs/RESULTS_SUBMISSION.md. This schema is not supplied by the organizers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "team_name",
    "model",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "team_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "name"
      ],
      "properties": {
        "mode": {
          "enum": [
            "local",
            "external_api",
            "hybrid"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "results": {
      "type": "array",
      "anyOf": [
        {
          "minItems": 10,
          "maxItems": 10
        },
        {
          "minItems": 65,
          "maxItems": 65
        }
      ],
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/okResult"
          },
          {
            "$ref": "#/definitions/errorResult"
          }
        ]
      }
    }
  },
  "definitions": {
    "conversationId": {
      "type": "string",
      "minLength": 1
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "value",
        "rationale",
        "evidence_turns"
      ],
      "properties": {
        "criterion_id": {
          "enum": [
            "contact",
            "discovery",
            "identification",
            "consultation",
            "empathy",
            "dialogue",
            "closure",
            "critical"
          ]
        },
        "value": {},
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence_turns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "criterion_id": {
              "const": "contact"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "properties": {
            "criterion_id": {
              "const": "discovery"
            },
            "value": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        {
          "properties": {
            "criterion_id": {
              "const": "identification"
            },
            "value": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        {
          "properties": {
            "criterion_id": {
              "const": "consultation"
            },
            "value": {
              "type": [
                "integer",
                "null"
              ],
              "enum": [
                0,
                5,
                10,
                15,
                20,
                null
              ]
            }
          }
        },
        {
          "properties": {
            "criterion_id": {
              "const": "empathy"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "properties": {
            "criterion_id": {
              "const": "dialogue"
            },
            "value": {
              "type": "integer",
              "enum": [
                0,
                4,
                7,
                10
              ]
            }
          }
        },
        {
          "properties": {
            "criterion_id": {
              "const": "closure"
            },
            "value": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        {
          "properties": {
            "criterion_id": {
              "const": "critical"
            },
            "value": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_score",
        "critical_flag"
      ],
      "properties": {
        "final_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.01
        },
        "critical_flag": {
          "type": "boolean"
        }
      }
    },
    "okResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "status",
        "criteria",
        "score"
      ],
      "properties": {
        "conversation_id": {
          "$ref": "#/definitions/conversationId"
        },
        "status": {
          "const": "ok"
        },
        "criteria": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "$ref": "#/definitions/criterion"
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": [
                  "criterion_id"
                ],
                "properties": {
                  "criterion_id": {
                    "const": "contact"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "criterion_id"
                ],
                "properties": {
                  "criterion_id": {
                    "const": "discovery"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "criterion_id"
                ],
                "properties": {
                  "criterion_id": {
                    "const": "identification"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "criterion_id"
                ],
                "properties": {
                  "criterion_id": {
                    "const": "consultation"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "criterion_id"
                ],
                "properties": {
                  "criterion_id": {
                    "const": "empathy"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "criterion_id"
                ],
                "properties": {
                  "criterion_id": {
                    "const": "dialogue"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "criterion_id"
                ],
                "properties": {
                  "criterion_id": {
                    "const": "closure"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "criterion_id"
                ],
                "properties": {
                  "criterion_id": {
                    "const": "critical"
                  }
                }
              }
            }
          ]
        },
        "score": {
          "$ref": "#/definitions/score"
        }
      }
    },
    "errorResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "status",
        "criteria",
        "score",
        "error"
      ],
      "properties": {
        "conversation_id": {
          "$ref": "#/definitions/conversationId"
        },
        "status": {
          "const": "error"
        },
        "criteria": {
          "type": "array",
          "maxItems": 0
        },
        "score": {
          "type": "null"
        },
        "error": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
