# Copy to .env; never commit .env. Keys stay on the backend.
# Paste the organizer-supplied signed URL locally, without group_id.
ORGANIZER_API_URL=
DATABASE_URL=sqlite:///./data/private/cqa.sqlite3
# Exact HTTPS origins allowed to serve voice recordings, comma separated.
CQA_AUDIO_ORIGINS=
# Set before import: public playback URLs are pinned to their conversation versions.
CQA_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Demo is synthetic. Live jobs require an approved plan and explicit enablement.
# Live use needs explicit provider/model/data permission and an approved local run plan.
EVALUATION_PROVIDER=unconfigured
MODEL_PROVIDER=
MODEL_ID=
MODEL_API_KEY=
LIVE_EVAL_ENABLED=false
# Private JSON plan with data scope, provider, prices, request cap and total budget.
CQA_LIVE_PLAN=
