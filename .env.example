# Copy to .env; never commit .env. Keys stay on the backend.
# Paste the organizer-supplied signed URL locally, without group_id.
ORGANIZER_API_URL=
DATABASE_URL=sqlite:///./data/private/cqa.sqlite3
# Offline-tested adapters exist; API workflow remains stage 0. Demo is synthetic.
# Live use needs explicit provider/model/data permission and an approved local run plan.
EVALUATION_PROVIDER=unconfigured
MODEL_PROVIDER=
MODEL_ID=
MODEL_API_KEY=
LIVE_EVAL_ENABLED=false
LIVE_EVAL_MAX_REQUESTS=0
LIVE_EVAL_BUDGET_USD=0
# evals.live reads limits from --plan; these environment limits are reserved for workflow C.
